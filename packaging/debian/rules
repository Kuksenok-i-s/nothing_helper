#!/usr/bin/make -f

export DH_VERBOSE=1
export GOFLAGS=

%:
	dh $@

override_dh_auto_build:
	go build -tags "gio systray" -o bin/tws_manager ./cmd/tws_manager
	go build -o bin/tws_manager_rfcomm_helper ./cmd/tws_manager_rfcomm_helper

override_dh_auto_test:
	go test ./...
	go vet ./...

# Go emits DWARF features unsupported by Debian's dwz optimizer.
# Keep normal dh_strip handling; only skip the optional DWARF deduplication.
override_dh_dwz:
